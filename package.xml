<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omron_moma_capabilities</name>
  <version>0.1.0</version>
  <description>Standalone Omron MOMA capability plans and launch wrappers for separate Nav2, grasping, and gripper testing.</description>
  <maintainer email="kalanaratnayake95@gmail.com">ubuntu</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <exec_depend>fabric_server</exec_depend>
  <exec_depend>grasping_capabilities</exec_depend>
  <exec_depend>gripper_capabilities</exec_depend>
  <exec_depend>nav2_capabilities</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>